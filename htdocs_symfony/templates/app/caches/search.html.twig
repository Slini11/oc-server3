{% extends 'app/base.html.twig' %}

{% block page_content %}

    <div>
        <h3>{{ 'Search for caches and users' | trans }}..</h3>
        {% if cachesForm is defined %}
            {{ form_start(cachesForm) }}
            {{ form_widget(cachesForm) }}
            {{ form_end(cachesForm) }}
        {% endif %}
    </div>

    <hr>
    <!-- Button trigger modal -->
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
        Launch demo modal
    </button>

    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Modal title</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    ...
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary">Save changes</button>
                </div>
            </div>
        </div>
    </div>

    <div>
        {% if caches_by_searchfield is defined and caches_by_searchfield != 0 %}
            {% if caches_by_searchfield %}
                <br/>
                <div> {{ 'Found' | trans }}: {{ caches_by_searchfield | length }} {{ 'cache(s)' | trans }}</div>
                <br/>
                <table class="table table-hover d-sm-none">
                    <tbody>
                    {% for cache in caches_by_searchfield %}
                        <tr onclick="window.location='{{ path('app_cache_by_wp_oc_gc', { 'wpID': cache.wp_oc }) }}'">
                            <td>{{ cache.type }}</td>
                            <td>
                                <b>{{ cache.name }}</b> <br/>
                                {{ cache.wp_oc }} | {{ cache.difficulty | ocFilterDifficulty }} | {{ cache.terrain | ocFilterTerrain }}<br />
                                {{ cache.size }} | {{ cache.username }}
                            </td>
                        </tr>


                    {% endfor %}
                    </tbody>
                </table>
                <table class="table table-striped table-hover d-none d-sm-block">
                    <thead class="thead-dark">
                    <tr>
                        <th scope="col" class="asc">{{ 'OC code' | trans }}</th>
                        <th scope="col" class="asc">{{ 'Cache title' | trans }}</th>
                        <th scope="col" class="asc">{{ 'Owner name' | trans }}</th>
                        <th scope="col">&nbsp;</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for cache in caches_by_searchfield %}
                        <tr>
                            <td>{{ cache.wp_oc }}</td>
                            <td>{{ cache.name }}</td>
                            <td>{{ cache.username }}</td>
                            <td>
                                <a class="btn btn-primary"
                                   href="{{ path('app_cache_by_wp_oc_gc', { 'wpID': cache.wp_oc }) }}">{{ 'Details' | trans }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <br/><br/>
                <span>{{ 'No cache found' | trans }}.. :-(</span>
            {% endif %}
        {% endif %}

    </div>

    <hr>

{% endblock %}
